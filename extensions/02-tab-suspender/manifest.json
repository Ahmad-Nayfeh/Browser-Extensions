{
  "manifest_version": 3,
  "name": "Sleepy Tabs – Tab Suspender & Saver",
  "version": "1.0.0",
  "key": "",
  "description": "Puts unused tabs to sleep to free memory, and saves whole windows of tabs into a list you can restore later.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
