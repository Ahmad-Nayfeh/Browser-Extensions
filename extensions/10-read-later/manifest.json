{
  "manifest_version": 3,
  "name": "Later – Read Later & Page Notes",
  "version": "1.0.0",
  "description": "Save pages to read later and write notes on any page. Everything stays on your computer – no account, no cloud.",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "tabs", "favicon"],
  "background": { "service_worker": "background.js" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+L" } } },
  "action": { "default_popup": "app.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
