{
  "manifest_version": 3,
  "name": "Blueprint – Export a Site's Full Design",
  "version": "1.0.0",
  "key": "",
  "description": "Analyze any website and export everything about its front-end – structure, design system, components with CSS and states, motion, responsive rules, assets, full CSS and a screenshot – as one Markdown file for Claude.",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      }
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
