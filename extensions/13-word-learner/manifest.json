{
  "manifest_version": 3,
  "name": "Lexi – Learn English Words While You Browse",
  "version": "1.0.0",
  "key": "",
  "description": "Double-click any English word to see its Arabic meaning, definition and pronunciation. Save it, then review with spaced repetition so you never forget it.",
  "minimum_chrome_version": "121",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
