{
  "manifest_version": 3,
  "name": "Night – Lightweight Dark Mode",
  "version": "1.0.0",
  "description": "Dark mode for every website using a single GPU filter – no page analysis, so it stays fast. Skips sites that are already dark.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["dark.css"],
    "run_at": "document_start"
  }],
  "commands": { "toggle-site": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Toggle dark mode on this site" } },
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup/popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
