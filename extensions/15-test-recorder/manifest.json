{
  "manifest_version": 3,
  "name": "Trace – Test Session Recorder",
  "version": "1.0.0",
  "key": "",
  "description": "Click to start, test your website, click again to stop. Get one Markdown report with every step you took, every error, failed request and page change – ready to give to Claude.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "webNavigation",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Start / stop recording"
    }
  },
  "action": {
    "default_title": "Trace – click to start recording",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
