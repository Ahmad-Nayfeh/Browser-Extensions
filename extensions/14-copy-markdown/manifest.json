{
  "manifest_version": 3,
  "name": "Copy as Markdown",
  "version": "1.0.0",
  "key": "",
  "description": "Copy a selection or a whole article as clean Markdown – headings, lists, tables, code and LaTeX math included.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage",
    "offscreen",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Copy selection (or the article) as Markdown"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
