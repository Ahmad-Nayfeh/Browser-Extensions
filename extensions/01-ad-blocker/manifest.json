{
  "manifest_version": 3,
  "name": "Shield – Ad & Tracker Blocker",
  "version": "1.0.0",
  "key": "",
  "description": "Blocks ads and trackers everywhere, including YouTube. Uses Chrome's native rule engine so it stays light.",
  "minimum_chrome_version": "121",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "webNavigation",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "easylist",
        "enabled": true,
        "path": "filters/easylist.json"
      },
      {
        "id": "easyprivacy",
        "enabled": true,
        "path": "filters/easyprivacy.json"
      },
      {
        "id": "peterlowe",
        "enabled": true,
        "path": "filters/peterlowe.json"
      },
      {
        "id": "youtube",
        "enabled": true,
        "path": "rules/youtube.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
